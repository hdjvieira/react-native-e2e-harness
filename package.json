{
  "name": "react-native-e2e-harness-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "test": "yarn workspaces foreach -A run test",
    "build": "yarn workspaces foreach -A run build",
    "verify": "prettier --check . && yarn typecheck && yarn test"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
