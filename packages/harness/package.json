{
  "name": "react-native-e2e-harness",
  "version": "0.1.0",
  "description": "End-to-end tests for React Native apps by testID: Appium + WebdriverIO runner, device plumbing, reports",
  "license": "MIT",
  "author": "Hugo Vieira",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hdjvieira/react-native-e2e-harness.git",
    "directory": "packages/harness"
  },
  "homepage": "https://github.com/hdjvieira/react-native-e2e-harness#readme",
  "bugs": {
    "url": "https://github.com/hdjvieira/react-native-e2e-harness/issues"
  },
  "keywords": [
    "react-native",
    "e2e",
    "appium",
    "webdriverio",
    "testid",
    "testing"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./device": {
      "types": "./dist/device.d.ts",
      "default": "./dist/device.js"
    },
    "./in-app": {
      "types": "./dist/in-app.d.ts",
      "default": "./dist/in-app.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "e2e-harness": "./dist/cli.js"
  },
  "files": [
    "dist",
    "dashboard",
    "ai",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "yarn build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts src/device-cli/*.test.ts src/dashboard/*.test.ts",
    "sync-skill": "tsx src/sync-skill.ts"
  },
  "dependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": ">=20.12",
    "@wdio/cli": "^9.33.1",
    "@wdio/globals": "^9.33.1",
    "@wdio/junit-reporter": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/logger": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "expect-webdriverio": "^7.0.1",
    "mocha": "^10.8.2",
    "tsx": "^4.23.15",
    "webdriverio": "^9.33.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "@wdio/types": "9.33.1",
    "typescript": "6.0.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
